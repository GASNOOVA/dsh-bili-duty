{
  "name": "dsh-bili-duty",
  "version": "1.1.0-personal.0",
  "description": "直播值守（个人定制版）：对固定主播自动值守并完成 B站 粉丝团每日任务（观看/弹幕/点赞/灯牌），基于 dsh-bili-live 改造",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "bilibili",
    "live",
    "duty"
  ],
  "license": "MIT",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "lib",
    "vendor",
    "README.md",
    "LICENSE",
    "docs"
  ],
  "engines": {
    "dsh": ">=0.1.7-rc.1",
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "react"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GASNOOVA/dsh-bili-duty.git"
  },
  "homepage": "https://github.com/GASNOOVA/dsh-bili-duty",
  "bugs": {
    "url": "https://github.com/GASNOOVA/dsh-bili-duty/issues"
  },
  "author": "Cheng Chen"
}
